<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.5</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.jv.spring</groupId>
	<artifactId>Ejemplo-Parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>Ejemplo-Parent</name>
	<description>Proyecto Base Monolito Multimódulo - Estructura Corporativa</description>

	<!-- Tus 5 módulos definitivos -->
	<modules>
		<module>ejemplo-api-core</module>
		<module>ejemplo-api-contract</module>
		<module>ejemplo-api-application</module>
		<module>ejemplo-api-jpaadapter</module>
		<module>ejemplo-api-restadapter</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<mapstruct.version>1.5.5.Final</mapstruct.version>
		<jackson.version>2.17.1</jackson.version>
		<junit-jupiter.version>5.11.0-M1</junit-jupiter.version>
		<h2.version>2.2.224</h2.version>
	</properties>

	<!-- Gestión centralizada de versiones (Evita repetir versiones en los hijos) -->
	<dependencyManagement>
		<dependencies>
			<!-- Dependencias cruzadas de tus propios módulos internos -->
			<dependency>
				<groupId>com.jv.spring</groupId>
				<artifactId>ejemplo-api-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jv.spring</groupId>
				<artifactId>ejemplo-api-contract</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jv.spring</groupId>
				<artifactId>ejemplo-api-application</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jv.spring</groupId>
				<artifactId>ejemplo-api-jpaadapter</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jv.spring</groupId>
				<artifactId>ejemplo-api-restadapter</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Librerías externas de tu POM original -->
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-annotations</artifactId>
				<version>${jackson.version}</version>
			</dependency>
			<dependency>
				<groupId>com.h2database</groupId>
				<artifactId>h2</artifactId>
				<version>${h2.version}</version>
			</dependency>

			<!-- Testing -->
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-api</artifactId>
				<version>${junit-jupiter.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Lombok hereda automáticamente en todos los módulos hijo -->
	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>
</project>
